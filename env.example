# Google Gemini API Key — get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Hugging Face token (only if using remote SD inference later)
# HF_TOKEN=your_hf_token_here

# App
APP_NAME=ComicCraft
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Image mode: "pillow" (fast, always works) or "diffusers" (local Stable Diffusion, needs GPU + torch)
IMAGE_MODE=pillow
